# ============================================================
# NOTENIX — Production Environment Variables
# Copy this to .env and fill in ALL values before deploying
# ============================================================

# ── Core ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Database ─────────────────────────────────────────────────
# SQLite (dev only):
# DATABASE_URL=sqlite+aiosqlite:///./notenix.db
#
# PostgreSQL (production — get from Supabase/Railway/Render):
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/notenix

# ── Stripe ───────────────────────────────────────────────────
# Use sk_live_ keys in production, sk_test_ for testing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Create products in Stripe dashboard -> copy price IDs
STRIPE_MONTHLY_PRICE_ID=price_...
STRIPE_YEARLY_PRICE_ID=price_...

# ── Email / SMTP ─────────────────────────────────────────────
# Recommended: Resend (resend.com) — free 3k emails/month
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key
MAIL_FROM=noreply@notenix.com
MAIL_FROM_NAME=Notenix
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Google OAuth ─────────────────────────────────────────────
# console.cloud.google.com -> APIs & Services -> Credentials
# Authorized redirect URI: https://api.notenix.com/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── App URLs ─────────────────────────────────────────────────
FRONTEND_URL=https://notenix.com
APP_URL=https://api.notenix.com

# ── Storage ──────────────────────────────────────────────────
# Railway/Render: use a persistent volume mounted at /data/chroma
CHROMA_PERSIST_DIR=/data/chroma
